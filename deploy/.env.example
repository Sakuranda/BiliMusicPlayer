# 安装脚本生成 deploy/.env（0600）；升级不覆盖。
# Compose 的变量替换须使用 --env-file deploy/.env。
MUSIC_DOMAIN=music.example.com
NAVIDROME_DOMAIN=navi.example.com
COMPOSE_PROFILES=https
APP_IMAGE=bilimusicplayer-api:local
API_PORT=8080
NAVIDROME_PORT=4533
HTTP_PORT=80
HTTPS_PORT=443
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_SECRET=
API_TOKEN=
ALLOWED_ORIGINS=https://music.example.com
SESSION_TTL_HOURS=720
DOWNLOAD_THREADS=3
METADATA_THREADS=4
BILI_API_INTERVAL=0.5
LYRICS_API_INTERVAL=0.35
COVER_MAX_SIZE=320
COVER_QUALITY=70
